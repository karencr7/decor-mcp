# =====================================================================
# Copia este archivo como ".env" y cambia TODOS los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).
# Usa solo letras y números en las contraseñas (sin @ : / # ni espacios).
# =====================================================================

# Superusuario de PostgreSQL (solo lo usa Docker para crear la base)
POSTGRES_USER=decor_admin
POSTGRES_PASSWORD=cambia_clave_admin

# Rol de SOLO LECTURA que usan las herramientas de consulta
DECOR_DB_LECTOR_PASSWORD=cambia_clave_lector

# Rol que lee usuarios/permisos y escribe la auditoría
DECOR_DB_APP_PASSWORD=cambia_clave_app

# Tokens de los 3 usuarios de demostración (inventa uno largo para cada uno).
# En la base solo se guarda su hash SHA-256.
DECOR_TOKEN_ADMIN=cambia_token_admin
DECOR_TOKEN_COMERCIAL=cambia_token_comercial
DECOR_TOKEN_CARTERA=cambia_token_cartera

# Asistente con IA (Groq). Crea la llave en https://console.groq.com/keys y pégala SOLO en tu .env.
# Si se deja vacía, la API funciona igual y /api/asistente/preguntar responde 503.
GROQ_API_KEY=
# DECOR_GROQ_MODELO=llama-3.3-70b-versatile

# --- Solo si ejecutas la API SIN Docker (uvicorn en tu PC) ---------------
# DECOR_DB_LECTOR_URL=postgresql://decor_lector:CLAVE@localhost:5433/decor
# DECOR_DB_APP_URL=postgresql://decor_app:CLAVE@localhost:5433/decor

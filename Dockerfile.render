# Imagen para la DEMO pública en Render (plan gratuito): PostgreSQL 16 + API en un solo contenedor.
# La base se crea en cada arranque con los mismos scripts de database/ (datos ficticios, efímera).
# Para desarrollo local se sigue usando docker-compose.yml. Ver docs/adr/ADR-002.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# PostgreSQL 16 desde el repositorio oficial (PGDG)
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && install -d /usr/share/postgresql-common/pgdg \
 && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-16 \
 && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY app ./app
COPY database ./database
COPY scripts/iniciar_render.sh ./scripts/iniciar_render.sh

# PostgreSQL no corre como root: todo el contenedor usa un usuario sin privilegios
RUN useradd --create-home decor && chown -R decor /srv
USER decor

EXPOSE 8000
CMD ["sh", "scripts/iniciar_render.sh"]
